{
  "name": "mneme",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "turbo run db:migrate",
    "db:migrate:run": "tsx scripts/migrate.ts",
    "contracts:compile": "cd contracts && npx hardhat compile",
    "contracts:test": "cd contracts && npx hardhat test",
    "contracts:deploy:devnet": "cd contracts && npx hardhat run scripts/deploy.ts --network monadDevnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.27",
    "ethers": "^6.17.0",
    "hardhat-gas-reporter": "^1.0.10",
    "next": "16.3.8",
    "prettier": "^3.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "turbo": "^2.0.0",
    "typechain": "^8.3.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "postcss": "8.5.29",
    "lodash": "4.18.1",
    "ip-address": "10.7.3",
    "fast-uri": "4.2.1",
    "hono": "4.13.13",
    "@hono/node-server": "^1.19.16",
    "fast-copy": "4.1.2",
    "qs": "6.16.0"
  }
}
