{
  "name": "@mneme/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "db:migrate": "drizzle-kit generate",
    "db:migrate:run": "tsx src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@huggingface/transformers": "^4.3.1",
    "@mneme/shared": "*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ioredis": "^5.3.2",
    "neo4j-driver": "^5.21.0",
    "node-cron": "^4.6.0",
    "openai": "^4.52.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.1",
    "postgres": "^3.4.4",
    "tiktoken": "^1.0.12",
    "uuid": "^14.0.2",
    "viem": "^2.55.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.21.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.0",
    "vitest": "4.1.11"
  }
}
